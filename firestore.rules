rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // Lookup staff profile for the calling user within a specific school
    function getStaffDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid));
    }

    function isSchoolStaff(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)) &&
        getStaffDoc(schoolId).data.active == true;
    }

    function getStaffRole(schoolId) {
      return getStaffDoc(schoolId).data.role;
    }

    function isSchoolAdmin(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER'];
    }

    // Guardian/emergency-contact data is restricted to the school leadership roles.
    function isStudentPrivacyStaff(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER'];
    }

    function sharedStudentRecordHasNoPrivateFields() {
      return !resource.data.keys().hasAny(['guardianName', 'guardianPhone', 'emergencyContact', 'notes']);
    }

    function isFinanceStaff(schoolId) {
      return isSchoolStaff(schoolId) &&
        (getStaffRole(schoolId) == 'BURSAR' ||
          (getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER'] &&
            getStaffDoc(schoolId).data.hasExplicitFinanceAccess == true));
    }

    function isGateStaff(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'SECURITY_HEAD', 'GATE_OFFICER'];
    }

    function isMealStaff(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'MATRON_PATRON', 'MEAL_STAFF'];
    }

    function isTeacher(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'DIRECTOR_OF_STUDIES', 'TEACHER'];
    }

    function isExamStaff(schoolId) {
      return isSchoolStaff(schoolId) && getStaffRole(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'DIRECTOR_OF_STUDIES', 'EXAM_STAFF'];
    }

    // Legacy /users data is intentionally denied. The production application uses
    // school-scoped collections under /schools/{schoolId}; no client access is granted
    // to the retired per-user schema.

    // -------------------------------------------------------------
    // SCHOOL-WIDE MULTI-TENANT ARCHITECTURE (/schools/{schoolId})
    // -------------------------------------------------------------
    match /schools/{schoolId} {
      allow get: if isSchoolStaff(schoolId);
      allow list: if false;

      // School staff membership roster
      match /staff/{staffUid} {
        allow get: if isSignedIn() && (request.auth.uid == staffUid || isSchoolStaff(schoolId));
        allow list: if isSchoolStaff(schoolId);
        // Staff roles are privileged. Provision the first administrator through a trusted
        // Firebase Admin SDK/bootstrap process; never allow a client to self-enroll or self-promote.
        allow create, update: if isSchoolAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Shared student records
      match /students/{studentId} {
        // Shared roster records must not contain guardian/emergency contact data.
        // Legacy records fail closed for non-leadership staff until migrated.
        allow get, list: if isSchoolStaff(schoolId) &&
                            (isStudentPrivacyStaff(schoolId) || sharedStudentRecordHasNoPrivateFields());
        allow create: if isSchoolAdmin(schoolId) &&
                         !request.resource.data.keys().hasAny(['guardianName', 'guardianPhone', 'emergencyContact', 'notes']);
        allow update: if
                         !request.resource.data.keys().hasAny(['guardianName', 'guardianPhone', 'emergencyContact', 'notes']) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']) &&
                         ((isSchoolAdmin(schoolId) &&
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feesStatus', 'outstandingAmount'])) ||
                          (isFinanceStaff(schoolId) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feesStatus', 'outstandingAmount', 'accessStatus', 'updatedAt'])));
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Sensitive student information is stored separately from the shared roster.
      match /student_private/{studentId} {
        allow get, list: if isStudentPrivacyStaff(schoolId);
        allow create, update: if isStudentPrivacyStaff(schoolId) &&
          request.resource.data.studentId == studentId &&
          request.resource.data.keys().hasOnly([
            'studentId', 'guardianName', 'guardianPhone', 'emergencyContact', 'notes', 'updatedAt'
          ]);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Shared card credentials
      match /cards/{cardId} {
        allow get, list: if isSchoolStaff(schoolId);
        allow create: if isSchoolAdmin(schoolId) &&
                         request.resource.data.status == 'ACTIVE' &&
                         request.resource.data.isDeleted == false;
        allow update: if isSchoolAdmin(schoolId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deactivationDate', 'replacedByCardId', 'reason', 'notes', 'updatedAt', 'isDeleted']) &&
                         !(resource.data.status in ['LOST', 'REPLACED', 'DEACTIVATED'] && request.resource.data.status == 'ACTIVE') &&
                         !(resource.data.isDeleted == true && request.resource.data.isDeleted == false) &&
                         request.resource.data.status in ['ACTIVE', 'LOST', 'REPLACED', 'DEACTIVATED'];
        allow delete: if false; // Cards are never deleted; status transitions to LOST/REPLACED/DEACTIVATED
      }

      // Departmental records: Gate Scan Logs (Append-Only)
      match /gate_logs/{logId} {
        allow get, list: if isGateStaff(schoolId);
        allow create: if isGateStaff(schoolId) &&
                         isValidId(logId) &&
                         request.resource.data.keys().hasAll(['id', 'studentNumber', 'decision', 'gateLocation', 'timestamp']) &&
                         !exists(/databases/$(database)/documents/schools/$(schoolId)/gate_logs/$(logId));
        allow update: if isGateStaff(schoolId) && request.resource.data == resource.data; // Idempotent retry only; records remain immutable
        allow delete: if false; // Strict audit trail
      }

      // Departmental records: Meals
      match /meals/{mealId} {
        allow get, list: if isMealStaff(schoolId);
        allow create: if isMealStaff(schoolId) &&
                         isValidId(mealId) &&
                         request.resource.data.keys().hasAll(['id', 'studentId', 'mealType', 'servingStation', 'timestamp']) &&
                         !exists(/databases/$(database)/documents/schools/$(schoolId)/meals/$(mealId));
        allow update: if isMealStaff(schoolId) && request.resource.data == resource.data; // Allow exact idempotent retry only
        allow delete: if false; // Immutable meal serving record
      }

      // Departmental records: Attendance
      match /attendance/{attId} {
        allow get, list: if isTeacher(schoolId);
        allow create: if isTeacher(schoolId) &&
                         isValidId(attId) &&
                         request.resource.data.keys().hasAll(['id', 'studentId', 'subject', 'status', 'timestamp']) &&
                         !exists(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(attId));
        allow update: if isTeacher(schoolId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'auditNote', 'syncedAt']);
        allow delete: if false;
      }

      // Departmental records: Exam Exceptions
      match /exam_exceptions/{exceptionId} {
        allow get, list: if isExamStaff(schoolId) || isFinanceStaff(schoolId);
        // Recommendations are bound to the authenticated finance UID.
        allow create: if isFinanceStaff(schoolId) &&
                         isValidId(exceptionId) &&
                         !exists(/databases/$(database)/documents/schools/$(schoolId)/exam_exceptions/$(exceptionId)) &&
                         request.resource.data.keys().hasAll([
                           'id', 'studentId', 'examCode', 'recommendedBy', 'recommendedByUid', 'isApproved'
                         ]) &&
                         request.resource.data.id == exceptionId &&
                         request.resource.data.recommendedByUid == request.auth.uid &&
                         request.resource.data.isApproved == false;
        // Approval is a one-way transition attributed to authenticated leadership.
        allow update: if
                         ((isFinanceStaff(schoolId) || isExamStaff(schoolId)) &&
                           request.resource.data == resource.data) ||
                         (isSchoolAdmin(schoolId) &&
                           resource.data.isApproved == false &&
                           request.resource.data.isApproved == true &&
                           request.resource.data.approvedByUid == request.auth.uid &&
                           request.resource.data.approvedAt is timestamp &&
                           request.resource.data.approvedAt <= request.time &&
                           request.resource.data.recommendedByUid == resource.data.recommendedByUid &&
                           request.resource.data.id == resource.data.id &&
                           request.resource.data.studentId == resource.data.studentId &&
                           request.resource.data.examCode == resource.data.examCode &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'isApproved', 'approvedByUid', 'approvedBy', 'approvalNote', 'approvedAt', 'updatedAt'
                           ]));
        allow delete: if isSchoolAdmin(schoolId);
      }
    }
  }
}
