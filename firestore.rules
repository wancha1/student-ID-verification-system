rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/staff/$(uid);
    }

    function hasStaffProfile(schoolId) {
      return signedIn()
        && exists(staffPath(schoolId, request.auth.uid));
    }

    function activeStaff(schoolId) {
      return hasStaffProfile(schoolId)
        && get(staffPath(schoolId, request.auth.uid)).data.active == true
        && get(staffPath(schoolId, request.auth.uid)).data.role
          in ['ADMIN', 'HEAD_TEACHER', 'GATE_OFFICER', 'MEAL_STAFF'];
    }

    function role(schoolId) {
      return get(staffPath(schoolId, request.auth.uid)).data.role;
    }

    function isAdmin(schoolId) {
      return activeStaff(schoolId) && role(schoolId) == 'ADMIN';
    }

    function isHeadTeacher(schoolId) {
      return activeStaff(schoolId) && role(schoolId) == 'HEAD_TEACHER';
    }

    function isLeadership(schoolId) {
      return isAdmin(schoolId) || isHeadTeacher(schoolId);
    }

    function isGateStaff(schoolId) {
      return activeStaff(schoolId)
        && role(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'GATE_OFFICER'];
    }

    function isGateOperator(schoolId) {
      return activeStaff(schoolId)
        && role(schoolId) in ['ADMIN', 'GATE_OFFICER'];
    }

    function isMealStaff(schoolId) {
      return activeStaff(schoolId)
        && role(schoolId) in ['ADMIN', 'HEAD_TEACHER', 'MEAL_STAFF'];
    }

    function isMealOperator(schoolId) {
      return activeStaff(schoolId)
        && role(schoolId) in ['ADMIN', 'MEAL_STAFF'];
    }

    function migrationComplete(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId))
          .data.studentPrivacyMigrationComplete == true;
    }

    function noPrivateStudentFields(data) {
      return !data.keys().hasAny([
        'guardianName', 'guardianPhone', 'emergencyContact', 'notes'
      ]);
    }

    function validStudent(data, studentId) {
      return data.id == studentId
        && data.studentNumber is string
        && data.name is string
        && data.firstName is string
        && data.lastName is string
        && data.gradeClass is string
        && data.updatedAt is number
        && data.isDayScholar is bool
        && data.feesStatus in ['CLEARED', 'OUTSTANDING']
        && data.outstandingAmount is number
        && data.outstandingAmount >= 0
        && data.accessStatus is string
        && data.keys().hasOnly([
          'id', 'studentNumber', 'name', 'firstName', 'lastName',
          'photoUrl', 'accessStatus', 'gradeClass', 'isDayScholar',
          'dayScholarType', 'transportRoute', 'feesStatus',
          'outstandingAmount', 'gender', 'avatarColorSeed',
          'homeroomTeacher', 'academicYear', 'qrToken', 'updatedAt',
          'isDeleted'
        ])
        && noPrivateStudentFields(data);
    }

    function validCard(data, cardId) {
      return data.id == cardId
        && data.cardIdentifier is string
        && data.studentId is string
        && data.studentNumber is string
        && data.qrPayload is string
        && data.status in ['ACTIVE', 'LOST', 'REPLACED', 'DEACTIVATED']
        && data.issueDate is number
        && data.updatedAt is number
        && data.isDeleted is bool
        && data.keys().hasOnly([
          'id', 'cardIdentifier', 'studentId', 'studentNumber',
          'qrPayload', 'status', 'issueDate', 'activationDate',
          'deactivationDate', 'replacedByCardId', 'reason', 'notes',
          'updatedAt', 'isDeleted'
        ]);
    }

    match /schools/{schoolId} {
      allow get: if activeStaff(schoolId);
      allow list: if false;

      match /staff/{staffUid} {
        allow get: if signedIn()
          && (request.auth.uid == staffUid || activeStaff(schoolId));
        allow list: if isAdmin(schoolId);

        // Only an existing administrator can manage another staff profile.
        // Provision the first administrator using the trusted Admin SDK script.
        allow create: if isAdmin(schoolId)
          && request.auth.uid != staffUid
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'active'
          ])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.role
            in ['ADMIN', 'HEAD_TEACHER', 'GATE_OFFICER', 'MEAL_STAFF']
          && request.resource.data.active is bool;

        allow update: if isAdmin(schoolId)
          && request.auth.uid != staffUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'role', 'active'])
          && request.resource.data.role
            in ['ADMIN', 'HEAD_TEACHER', 'GATE_OFFICER', 'MEAL_STAFF']
          && request.resource.data.active is bool;

        allow delete: if false;
      }

      match /students/{studentId} {
        allow get, list: if activeStaff(schoolId)
          && (isLeadership(schoolId) || migrationComplete(schoolId));

        allow create: if isAdmin(schoolId)
          && validStudent(request.resource.data, studentId);

        allow update: if isAdmin(schoolId)
          && validStudent(request.resource.data, studentId)
          && request.resource.data.id == resource.data.id;

        // Preserve student history. Use isDeleted for archival.
        allow delete: if false;
      }

      match /student_private/{studentId} {
        allow get, list: if isLeadership(schoolId);

        allow create, update: if isLeadership(schoolId)
          && request.resource.data.studentId == studentId
          && request.resource.data.keys().hasOnly([
            'studentId', 'guardianName', 'guardianPhone',
            'emergencyContact', 'notes', 'updatedAt'
          ])
          && request.resource.data.updatedAt is number;

        allow delete: if isAdmin(schoolId);
      }

      match /cards/{cardId} {
        allow get, list: if activeStaff(schoolId);

        allow create: if isAdmin(schoolId)
          && validCard(request.resource.data, cardId);

        allow update: if isAdmin(schoolId)
          && validCard(request.resource.data, cardId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.cardIdentifier == resource.data.cardIdentifier
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentNumber == resource.data.studentNumber
          && request.resource.data.qrPayload == resource.data.qrPayload
          && request.resource.data.issueDate == resource.data.issueDate
          && !(
            resource.data.status in ['LOST', 'REPLACED', 'DEACTIVATED']
            && request.resource.data.status == 'ACTIVE'
          )
          && !(
            resource.data.isDeleted == true
            && request.resource.data.isDeleted == false
          );

        allow delete: if false;
      }

      match /gate_logs/{logId} {
        allow get, list: if isGateStaff(schoolId);

        allow create: if isGateOperator(schoolId)
          && logId.size() > 0
          && request.resource.data.id == logId
          && request.resource.data.studentNumber is string
          && request.resource.data.studentName is string
          && request.resource.data.decision is string
          && request.resource.data.gateLocation is string
          && request.resource.data.timestamp is number
          && request.resource.data.keys().hasOnly([
            'id', 'studentNumber', 'studentName',
            'decision', 'gateLocation', 'timestamp'
          ])
          && !exists(
            /databases/$(database)/documents/schools/$(schoolId)/gate_logs/$(logId)
          );

        allow update: if isGateOperator(schoolId)
          && request.resource.data == resource.data;

        allow delete: if false;
      }

      match /meals/{mealId} {
        allow get, list: if isMealStaff(schoolId);

        allow create: if isMealOperator(schoolId)
          && mealId.size() > 0
          && request.resource.data.id == mealId
          && request.resource.data.studentId is string
          && request.resource.data.studentNumber is string
          && request.resource.data.studentName is string
          && request.resource.data.gradeClass is string
          && request.resource.data.mealType in ['LUNCH', 'SUPPER']
          && request.resource.data.mealDate is string
          && request.resource.data.status is string
          && request.resource.data.notes is string
          && request.resource.data.servingStation is string
          && request.resource.data.timestamp is number
          && request.resource.data.keys().hasOnly([
            'id', 'studentId', 'studentNumber', 'studentName',
            'gradeClass', 'mealType', 'mealDate', 'status',
            'notes', 'servingStation', 'timestamp'
          ])
          && !exists(
            /databases/$(database)/documents/schools/$(schoolId)/meals/$(mealId)
          );

        allow update: if isMealOperator(schoolId)
          && request.resource.data == resource.data;

        allow delete: if false;
      }
    }

    // All other collections, including attendance, finance and exam exceptions,
    // are denied by default in Version 1.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}