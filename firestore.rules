rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // 1. Staff User Profile Validation
    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'BURSAR', 'DIRECTOR_OF_STUDIES', 'SECURITY_HEAD', 'GATE_OFFICER', 'MATRON_PATRON'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 2. Student Record Validation
    function isValidStudent(data, userId) {
      return data.userId == userId &&
             data.studentNumber is string && data.studentNumber.size() > 0 && data.studentNumber.size() <= 50 &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 50 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 50 &&
             data.gradeClass is string && data.gradeClass.size() > 0 && data.gradeClass.size() <= 50 &&
             data.isDayScholar is bool &&
             data.feesStatus in ['CLEARED', 'OUTSTANDING', 'GRACE_PERIOD'] &&
             (data.outstandingAmount is int || data.outstandingAmount is float) &&
             data.outstandingAmount >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 3. Card Record Validation
    function isValidCard(data, userId) {
      return data.userId == userId &&
             data.cardIdentifier is string && data.cardIdentifier.size() > 0 && data.cardIdentifier.size() <= 64 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentNumber is string && data.studentNumber.size() > 0 && data.studentNumber.size() <= 50 &&
             data.qrPayload is string && data.qrPayload.size() <= 512 &&
             data.status in ['ACTIVE', 'LOST', 'REPLACED', 'DEACTIVATED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 4. Scan Log Validation (Append-Only)
    function isValidScanLog(data, userId) {
      return data.userId == userId &&
             data.studentNumber is string && data.studentNumber.size() > 0 && data.studentNumber.size() <= 50 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100 &&
             data.decision is string && data.decision.size() > 0 && data.decision.size() <= 50 &&
             data.gatePoint is string && data.gatePoint.size() > 0 && data.gatePoint.size() <= 50 &&
             isValidTimestamp(data.scannedAt);
    }

    // -------------------------------------------------------------
    // COLLECTION RULES
    // -------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
                       isValidUser(request.resource.data, userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidUser(request.resource.data, userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']);

      allow delete: if false;

      // Subcollection: Students
      match /students/{studentId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(studentId) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'studentNumber', 'firstName', 'lastName', 'gradeClass', 'isDayScholar', 'feesStatus', 'outstandingAmount', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'studentNumber', 'firstName', 'lastName', 'gradeClass', 'isDayScholar', 'feesStatus', 'outstandingAmount', 'createdAt', 'updatedAt']) &&
                         isValidStudent(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidId(studentId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidStudent(request.resource.data, userId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentNumber', 'firstName', 'lastName', 'gradeClass', 'isDayScholar', 'feesStatus', 'outstandingAmount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(studentId);
      }

      // Subcollection: Cards
      match /cards/{cardId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(cardId) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'cardIdentifier', 'studentId', 'studentNumber', 'qrPayload', 'status', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'cardIdentifier', 'studentId', 'studentNumber', 'qrPayload', 'status', 'createdAt', 'updatedAt']) &&
                         isValidCard(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidId(cardId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidCard(request.resource.data, userId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'qrPayload', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(cardId);
      }

      // Subcollection: Scan Logs (Append-Only Audit Trail)
      match /scan_logs/{logId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'studentNumber', 'studentName', 'decision', 'gatePoint', 'scannedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'studentNumber', 'studentName', 'decision', 'gatePoint', 'scannedAt']) &&
                         isValidScanLog(request.resource.data, userId);

        allow update, delete: if false; // Strict immutable audit log
      }
    }
  }
}
